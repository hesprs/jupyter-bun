{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun"],
		"paths": {
			"@/*": ["./src/*"],
			"@": ["./src"]
		}
	},
	"include": ["src", "test"]
}
